{
  "name": "laundry-vibes-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API + static hosting for the Laundry Vibes website",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm --prefix ../frontend install --include=dev && npm --prefix ../frontend run build",
    "test": "node test/smoke.test.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.8"
  }
}
